{
  "name": "tripcraft",
  "version": "1.0.0",
  "description": "TripCraft · 旅艺 —— 多端同步、多人共享的 AI 旅行规划 App：对话说需求，AI 规划自驾或匹配旅行社线路；为旅行社提供线路上架、AI 路书与透明报价（产品设计与系统架构全案）",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "validate": "node tools/validate-schemas.js",
    "check-links": "node tools/check-links.mjs \"{README.md,docs/**/*.md,docs/*.md}\"",
    "check-br025": "node tools/check-br025.mjs --self-test",
    "check-trace": "node tools/check-trace.mjs",
    "check": "npm run validate && npm run check-links && npm run check-br025 && npm run check-trace",
    "showcase:dev": "npm --prefix apps/showcase run dev",
    "showcase:build": "npm --prefix apps/showcase run build",
    "showcase:serve": "node apps/showcase/server.mjs",
    "showcase:typecheck": "npm --prefix apps/showcase run typecheck"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "comments": {
    "runtime-dependencies": "ZERO. 本 package.json 仅承载开发期校验工具，编译产物与运行时不含任何 npm 依赖。见 docs/00-overview-and-glossary.md 铁律 1「零构建交付」。"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnMaxwell0123/TripCraft.git"
  }
}
